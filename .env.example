# PostgreSQL connection (choose one style)
DATABASE_URL=postgresql://user:password@localhost:5432/mydb
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=mydb
# PGUSER=user
# PGPASSWORD=password

# Safety
MCPBRIDGE_MODE=read-only                 # read-only | read-write
MCPBRIDGE_MAX_ROWS=100
MCPBRIDGE_QUERY_TIMEOUT_MS=30000
MCPBRIDGE_HIGH_RISK_ROW_THRESHOLD=100
MCPBRIDGE_CONFIRMATION_TTL_SECONDS=600
MCPBRIDGE_BLOCKED_TABLES=

# Throttling & caching
MCPBRIDGE_RATE_LIMIT=100
MCPBRIDGE_RATE_WINDOW_SECONDS=60
MCPBRIDGE_SCHEMA_CACHE_TTL_SECONDS=300
MCPBRIDGE_MAX_CONNECTIONS=10

# Audit
MCPBRIDGE_AUDIT_LOG=mcpbridge-audit.jsonl

# Transport
MCPBRIDGE_TRANSPORT=stdio                # stdio | http
MCPBRIDGE_HTTP_PORT=3920
MCPBRIDGE_DEFAULT_SCHEMA=public
