{
  "name": "mcpbridge",
  "version": "1.0.0",
  "description": "Production-grade MCP server for PostgreSQL with safety guardrails, schema intelligence, guarded writes, and audit logging",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "mcpbridge": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "postgresql",
    "database",
    "ai",
    "claude"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "tsx": "^4.23.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
